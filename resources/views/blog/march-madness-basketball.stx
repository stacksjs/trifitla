<script server>
/*
 * Blog post. The body is the club's own writing, ported across; everything
 * around it — the header, the meta line, the neighbours at the foot — is
 * derived from the shared post index so no fact is stated twice.
 */

import { articleJsonLd, neighbours, posts } from '../../site/blog'
import { cardFor, cardHeight, cardType, cardWidth } from '../../site/social'
import { club, footerColumns, hours, legalLinks, navLinks, siteUrl } from '../../site/club'

const slug = 'march-madness-basketball'
const post = posts.find(p => p.slug === slug)
const { prev, next } = neighbours(slug)
const path = `/blog/${slug}`
</script>

@nolayout

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('site/head', {
      title: `${post.title} - TRIFIT LA`,
      description: post.excerpt,
      path,
      siteUrl,
      card: cardFor(path),
      cardType,
      cardWidth,
      cardHeight,
      cardAlt: post.title,
      ogType: 'article',
      jsonLd: articleJsonLd(post, siteUrl),
    })
  </head>

  <body>
    @include('site/nav', { navLinks, current: '/blog' })

    <main>
      <article>
        <header class="page-head">
          <div class="shell">
            <nav class="crumbs" aria-label="Breadcrumb">
              <a data-stx-link href="/">Home</a>
              <span aria-hidden="true">/</span>
              <a data-stx-link href="/blog">Blog</a>
              <span aria-hidden="true">/</span>
              <span>{{ post.topic }}</span>
            </nav>
            <span class="eyebrow">{{ post.topic }}</span>
            <h1>{{ post.title }}</h1>
            <div class="article-meta">
              <time datetime="{{ post.date }}">{{ post.dateLabel }}</time>
              <span>{{ post.minutes }} minute read</span>
              <span>TRIFIT LA</span>
            </div>
          </div>
        </header>

        <div class="section shell">
          <figure class="prose-figure post-hero">
            <img src="{{ post.image }}" alt="{{ post.alt }}" width="1400" height="933" fetchpriority="high" decoding="async">
          </figure>

          <div class="prose">
      <h2>Presented by TRIFIT x BXP</h2>
      <p>Tuesday, March 31st | 12:00 PM – 3:00 PM</p>
      <p>Get ready to hit the court at our annual March Madness Basketball Event at Colorado Center Park. Whether you're a seasoned player or just looking for some fun, this is your chance to compete, connect, and be part of the TRIFIT community.</p>
      <p>The event kicks off with a fast-paced Free Throw Contest (12:30 PM – 1:00 PM), where participants will have 30 seconds to make as many shots as possible. Space is limited, and the top performers will take home gift cards.</p>
      <p>From 1:00 PM – 3:00 PM, step into TRIFIT's 4-on-4 Tournament and compete in our Elite 8-style bracket. Sign up as a full team or as an individual, and we'll help place you on a team.</p>
      <h2>Compete, Connect, and Win</h2>
      <p>This event is open to all TRIFIT members and Colorado Center tenants. Teams are limited to one entry per tenant/company, and spots will fill quickly.</p>
      <p>The championship team will take home gift cards along with a one-month TRIFIT membership (current members can gift their membership to a friend).</p>
      <p>To register, visit the TRIFIT front desk or email contact@trifitla.com by Wednesday, March 25th.</p>
      <p>Come cheer on your coworkers, enjoy lunch and refreshments courtside, and see who rises to the top at March Madness 2026. Don't miss it!</p>
          </div>

          <nav class="post-nav" aria-label="More posts">
            @if (prev)
              <a data-stx-link href="/blog/{{ prev.slug }}">
                <span>Older</span>
                <b>{{ prev.title }}</b>
              </a>
            @else
              <span></span>
            @endif
            @if (next)
              <a data-stx-link class="is-next" href="/blog/{{ next.slug }}">
                <span>Newer</span>
                <b>{{ next.title }}</b>
              </a>
            @endif
          </nav>
        </div>
      </article>

      <section class="section--tight shell">
        <div class="closer">
          <div>
            <h2>Come and see the club for yourself.</h2>
          </div>
          <div>
            <p>Call ahead for a tour, or try everything for a day with a $39 day pass.</p>
            <div class="hero-cta">
              <a data-stx-link class="btn btn--primary" href="/visit-us">Book a tour</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    @include('site/footer', { club, hours, footerColumns, legalLinks })
  </body>
</html>
