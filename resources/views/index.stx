              </div>
            </article>
          @endforeach
        </div>
      </section>

      <!-- ── Classes ───────────────────────────────────────────────── -->
      <section class="section classes" id="classes" aria-labelledby="classes-heading">
        <div class="shell">
          <div class="section-head rise">
