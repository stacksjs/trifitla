              height="1066"
              loading="lazy"
              decoding="async"
            >
          </div>

          <div class="rise">
            <div class="section-head">
              <h2 id="visit-heading">Come see it.</h2>
              <p>Walk in for a tour, or call ahead and we will have someone free to show you around.</p>
            </div>

            <dl class="hours">
              @foreach (hours as row)
                <div>
                  <dt>{{ row.days }}</dt>
                  <dd>{{ row.time }}</dd>
                </div>
              @endforeach
            </dl>

            <div class="contact-lines">
              <div>{{ club.street }}, {{ club.city }}</div>
              <div><a href="{{ club.phoneHref }}">{{ club.phone }}</a></div>
              <div><a href="mailto:{{ club.email }}">{{ club.email }}</a></div>
            </div>

            <h3 class="sr-only">What comes with every membership</h3>
            <ul class="included">
              @foreach (included as item)
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
                  <span>{{ item }}</span>
                </li>
              @endforeach
            </ul>
          </div>
        </div>
      </section>

      <!-- ── Closing call to action ────────────────────────────────── -->
      <section class="section--tight shell">
        <div class="closer rise">
          <div>
            <h2>Train stronger, move better, look your best.</h2>
          </div>
          <div>
            <p>Month to month, with a 60-day minimum. No year-long contract to sign.</p>
            <div class="hero-cta">
              <a class="btn btn--primary" href="#membership">Join us</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ── Footer ──────────────────────────────────────────────────── -->
    <footer class="footer">
      <div class="shell">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/" aria-label="TRIFIT LA, home">
              <img src="/images/trifit/TRIFIT_LOGOS_white_horizontal.png" alt="TRIFIT LA" width="132" height="25">
            </a>
            <address>
              {{ club.street }}<br>
              {{ club.city }}<br>
              <a href="{{ club.phoneHref }}">{{ club.phone }}</a><br>
              <a href="mailto:{{ club.email }}">{{ club.email }}</a>
            </address>
          </div>

          <div>
            <h4>The club</h4>
            <div class="footer-links">
              <a href="#facility">Facility</a>
              <a href="#classes">Classes</a>
              <a href="#coaching">Coaching</a>
              <a href="#membership">Membership</a>
            </div>
          </div>

          <div>
            <h4>Visit</h4>
            <div class="footer-links">
              <a href="#visit">Hours and location</a>
              <a href="#membership">Day pass</a>
              <a href="{{ club.phoneHref }}">Call the front desk</a>
            </div>
          </div>

          <div>
            <h4>Hours</h4>
            <div class="footer-links">
              @foreach (hours as row)
                <span>{{ row.days }}, {{ row.time }}</span>
              @endforeach
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <span>&copy; 2026 TRIFIT LA. All rights reserved.</span>
