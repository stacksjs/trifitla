                <b>{{ plan.price }}</b>
                <span>{{ plan.period }}</span>
              </div>
              <p class="plan-note">{{ plan.note }}</p>
              <ul>
                @foreach (plan.lines as line)
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
                    <span>{{ line }}</span>
                  </li>
                @endforeach
              </ul>
              <div class="plan-foot">
                <a class="btn btn--primary btn--sm" href="#visit">{{ plan.cta }}</a>
