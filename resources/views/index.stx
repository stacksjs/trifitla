        </div>

        <div class="bento">
          @foreach (facility as item)
            <article class="tile rise tile--{{ item.area }} {{ item.image ? 'tile--photo' : '' }} {{ item.tone === 'tint' ? 'tile--tint' : '' }} {{ item.tone === 'ink' ? 'tile--ink' : '' }}">
              @if (item.image)
                <img src="{{ item.image }}" alt="{{ item.alt }}" width="1200" height="800" loading="lazy" decoding="async">
              @endif
