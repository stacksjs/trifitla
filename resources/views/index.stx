            @endforeach
          </div>
          <p class="also-note">Ocean Swim is free and open to the public, Fridays at 6:30 am from May through September.</p>
        </div>
      </section>

      <!-- ── Coaching ──────────────────────────────────────────────── -->
      <section class="section shell" id="coaching" aria-labelledby="coaching-heading">
        <div class="split split--reverse">
          <div class="split-media rise">
            <img
              src="/images/trifit/coaching.jpg"
              alt="A TRIFIT LA coach correcting a member's shoulder press form"
              width="1536"
              height="1024"
              loading="lazy"
              decoding="async"
            >
          </div>

          <div class="rise">
            <div class="section-head">
              <h2 id="coaching-heading">Coaching that starts with data.</h2>
              <p>Exercise physiologists write the plan, and exercise scientists on staff test where you actually are before they do.</p>
            </div>

            <div class="testing">
              @foreach (testing as item)
                <div>
                  <h3>{{ item.title }}</h3>
                  <p>{{ item.text }}</p>
                </div>
