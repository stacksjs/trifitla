<script server>
/*
 * TRIFIT LA landing page.
 *
 * Every number, price, class name, hour and address on this page comes from
 * trifitla.com. Nothing here is invented: no fabricated testimonials, no made
 * up statistics, no placeholder partner logos.
 *
 * The page is now a doorway rather than the whole site: each section states
 * its case and hands off to the page that carries the detail. Shared data —
 * the club, the classes, the plans — is imported so a price or a class time
 * is written down in exactly one place.
 */

import { featuredClasses, schedule, weeklySessionCount } from '../site/classes'
import { cardFor, cardHeight, cardType, cardWidth } from '../site/social'
import { awardYears, club, clubJsonLd, footerColumns, hours, included, legalLinks, navLinks, siteUrl } from '../site/club'
import { plans } from '../site/membership'

const path = '/'
const title = 'TRIFIT LA - Santa Monica\'s most loved gym'
const description = 'A 29,000 square foot family-owned club in Santa Monica: 25-yard lap pool, tennis, squash, strength, recovery, and coaching, six times voted Santa Monica\'s Most Loved Gym.'

/*
 * Facility bento. Six items, six cells, no filler tile. Sizes are assigned in
 * CSS by `area` so the grid has rhythm instead of six equal boxes.
 */
const facility = [
  {
    area: 'pool',
    title: 'The lap pool',
    text: 'Three lanes, 25 yards, indoors and temperature controlled all year.',
    image: '/images/trifit/trifit-indoors-Pools.jpg',
    alt: 'The indoor 25-yard lap pool at TRIFIT LA with lane ropes and pennants overhead',
  },
  {
    area: 'recovery',
    title: 'Recovery',
    text: 'Cold plunge, sauna, steam room, and massage recovery pods.',
    image: '/images/trifit/cold-plunge.jpg',
    alt: 'The cold plunge in the recovery suite at TRIFIT LA',
  },
  {
    area: 'squash',
    title: 'Squash',
    text: 'Professional courts, with open play every week.',
    image: '/images/trifit/squash-courts.jpg',
    alt: 'Glass-backed squash courts at TRIFIT LA',
  },
  {
    area: 'strength',
    title: 'Strength and cardio',
    text: 'Racks, platforms, machines, and a full cardio floor.',
    image: '/images/trifit/WEB-55.jpg',
    alt: 'The strength training floor at TRIFIT LA lit in blue and green',
  },
  {
    area: 'tennis',
    title: 'Tennis',
    text: 'Members reserve first. Open play on the west court is $5 an hour.',
    image: '/images/trifit/tennis-court.jpg',
    alt: 'The TRIFIT LA tennis court framed by palm trees',
  },
  {
    area: 'studios',
    tone: 'ink',
    title: 'Three studios',
    text: 'Cycling, yoga, and the group exercise room.',
  },
]

// Real services offered by the on-staff exercise scientists.
const testing = [
  { title: 'VO₂ max', text: 'How much oxygen you actually use at effort, measured rather than estimated.' },
  { title: 'Resting metabolic rate', text: 'What your body burns at rest, so nutrition targets start from a real number.' },
  { title: 'Body composition', text: 'Lean mass and fat mass tracked over time, not a single bathroom-scale reading.' },
]

// The eight classes not carried on the photo rail, listed by name so all
// sixteen are on the page without a sixteen-row list.
const railNames = new Set(featuredClasses.map(c => c.name))
const alsoOnSchedule = [...new Set(schedule.flatMap(day => day.slots.map(slot => slot.name)))]
  .filter(name => !railNames.has(name))
  .sort()

const years = new Date().getFullYear() - club.since
</script>

@nolayout

<!DOCTYPE html>
<html lang="en">
  <head>
    @include('site/head', {
      title,
      description,
      path,
      siteUrl,
      card: cardFor(path),
      cardType,
      cardWidth,
      cardHeight,
      jsonLd: clubJsonLd(),
    })
    <link rel="preload" as="image" href="/images/trifit/untitled-shoot-270.jpg" fetchpriority="high">
  </head>

  <body>
    @include('site/nav', { navLinks, current: path })

    <main>
      <!-- ── Hero ──────────────────────────────────────────────────── -->
      <section class="section shell hero">
        <div class="hero-grid">
          <div class="hero-animate">
            <h1 class="hero-title">One roof.<br>Every way to <em>train</em>.</h1>
            <p class="hero-sub">Pool, tennis, squash, strength, recovery, and coaching across {{ club.squareFeet }} square feet on Colorado Ave. Family owned in Santa Monica for {{ years }} years.</p>
            <div class="hero-cta">
              <a data-stx-link class="btn btn--primary" href="/membership">Join us</a>
              <a data-stx-link class="btn btn--ghost" href="/visit-us">Book a tour</a>
            </div>
          </div>

          <div class="hero-media">
            <StxImage src="/images/trifit/untitled-shoot-270.jpg" alt="A member on the training floor at TRIFIT LA" width="1200" height="800" lazy="false" placeholder="blur" fetchpriority="high" />
          </div>
        </div>
      </section>

      <!-- ── Award strip ───────────────────────────────────────────── -->
      <section class="awards" aria-labelledby="awards-heading">
        <div class="shell awards-inner">
          <h2 id="awards-heading" class="awards-label">Voted Santa Monica's <span>Most Loved Gym</span>, six years running.</h2>
          <div class="awards-years">
            @foreach (awardYears as year)
              <b>{{ year }}</b>
            @endforeach
          </div>
        </div>
      </section>

      <!-- ── Facility bento ────────────────────────────────────────── -->
      <section class="section shell" id="facility" aria-labelledby="facility-heading">
        <div class="section-head rise">
          <h2 id="facility-heading">A club, not a gym floor.</h2>
          <p>Swim, hit a ball, lift, and recover without leaving the building or booking a second membership.</p>
        </div>

        <div class="bento">
          @foreach (facility as item)
            <article class="tile rise tile--{{ item.area }} {{ item.image ? 'tile--photo' : '' }} {{ item.tone === 'tint' ? 'tile--tint' : '' }} {{ item.tone === 'ink' ? 'tile--ink' : '' }}">
              @if (item.image)
                <StxImage :src="item.image" :alt="item.alt" width="1200" height="800" placeholder="blur" />
              @endif
              <div class="tile-body">
                <h3>{{ item.title }}</h3>
                <p>{{ item.text }}</p>
              </div>
            </article>
          @endforeach
        </div>

        <div class="hero-cta">
          <a data-stx-link class="btn btn--ghost" href="/benefits">Every amenity, in detail</a>
        </div>
      </section>

      <!-- ── Classes ───────────────────────────────────────────────── -->
      <section class="section classes" id="classes" aria-labelledby="classes-heading">
        <div class="shell">
          <div class="section-head rise">
            <h2 id="classes-heading">Sixteen classes, one schedule.</h2>
            <p>{{ weeklySessionCount }} coached sessions a week, indoors and out, from 6 am starts to evening sessions. All of it included in every membership.</p>
          </div>
        </div>

        <div class="rail" role="region" aria-label="Class types" tabindex="0">
          @foreach (featuredClasses as item)
            <a data-stx-link class="class-card" href="/classes#{{ item.slug }}">
              <StxImage :src="item.image" :alt="item.alt" width="1200" height="800" placeholder="blur" />
              <div class="class-card-body">
                <h3>{{ item.name }}</h3>
                <p>{{ item.where }}</p>
              </div>
            </a>
          @endforeach
        </div>

        <div class="shell">
          <div class="also">
            @foreach (alsoOnSchedule as name)
              <span class="chip">{{ name }}</span>
            @endforeach
          </div>
          <p class="also-note">Ocean Swim is free and open to the public, Fridays at 6:30 am from May through September.</p>
          <div class="hero-cta">
            <a data-stx-link class="btn btn--primary" href="/classes">See the full week</a>
            <a data-stx-link class="btn btn--ghost" href="/events">Events</a>
          </div>
        </div>
      </section>

      <!-- ── Coaching ──────────────────────────────────────────────── -->
      <section class="section shell" id="coaching" aria-labelledby="coaching-heading">
        <div class="split split--reverse">
          <div class="split-media rise">
            <StxImage src="/images/trifit/vo2-max.jpg" alt="A VO₂ max test underway with an exercise scientist at TRIFIT LA" width="1400" height="1470" placeholder="blur" />
          </div>

          <div class="rise">
            <div class="section-head">
              <h2 id="coaching-heading">Coaching that starts with data.</h2>
              <p>Exercise physiologists write the plan, and exercise scientists on staff test where you actually are before they do.</p>
            </div>

            <div class="testing">
              @foreach (testing as item)
                <div>
                  <h3>{{ item.title }}</h3>
                  <p>{{ item.text }}</p>
                </div>
              @endforeach
            </div>

            <div class="hero-cta">
              <a data-stx-link class="btn btn--ghost" href="/services">Services and prices</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Family owned ──────────────────────────────────────────── -->
      <section class="section band" aria-labelledby="family-heading">
        <div class="shell split">
          <div class="split-media rise">
            <StxImage src="/images/trifit/Trifit_Family.jpg" alt="Gina and Bernard Baski with their two sons and their Rottweiler, Banksy" width="819" height="937" placeholder="blur" />
          </div>

          <div class="rise">
            <div class="section-head">
              <h2 id="family-heading">Santa Monica's largest independent, family-owned club.</h2>
              <p>No head office in another state and no regional manager. Gina and Bernard Baski have run TRIFIT LA since {{ club.since }}, and they are usually in the building.</p>
            </div>
            <p class="note">In {{ years }} years we have created local jobs, hosted some of LA County's largest free outdoor workouts, and supported local fitness clubs, races, and nonprofits.</p>
            <div class="hero-cta">
              <a data-stx-link class="btn btn--ghost" href="/about">Our story and the team</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Membership ────────────────────────────────────────────── -->
      <section class="section shell" id="membership" aria-labelledby="membership-heading">
        <div class="section-head rise">
          <h2 id="membership-heading">Membership</h2>
          <p>Every plan opens the whole club: pool, courts, floors, studios, recovery, and unlimited classes.</p>
        </div>

        <div class="plans">
          @foreach (plans as plan)
            <article class="plan rise {{ plan.featured ? 'plan--featured' : '' }}">
              <h3>{{ plan.name }}</h3>
              <div class="plan-price">
                <b>{{ plan.price }}</b>
                <span>{{ plan.period }}</span>
              </div>
              <p class="plan-note">{{ plan.note }}</p>
              <ul>
                @foreach (plan.lines as line)
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
                    <span>{{ line }}</span>
                  </li>
                @endforeach
              </ul>
              <div class="plan-foot">
                <a data-stx-link class="btn btn--primary btn--sm" href="{{ plan.ctaUrl }}">{{ plan.cta }}</a>
              </div>
            </article>
          @endforeach
        </div>

        <div class="daypass rise">
          <div>
            <h3>Not ready for a membership?</h3>
            <p>A day pass is $39 and covers everything a member gets that day, including the pool, the squash courts, and free parking.</p>
          </div>
          <div>
            <h3>The small print, up front</h3>
            <p>A one-time parking badge is $29. Tennis on the west court is $5 an hour during open play.</p>
          </div>
        </div>
      </section>

      <!-- ── Visit ─────────────────────────────────────────────────── -->
      <section class="section visit" id="visit" aria-labelledby="visit-heading">
        <div class="shell split">
          <div class="split-media rise">
            <StxImage src="/images/trifit/be-humble.jpg" alt="The front desk and training floor at TRIFIT LA" width="1600" height="1066" placeholder="blur" />
          </div>

          <div class="rise">
            <div class="section-head">
              <h2 id="visit-heading">Come see it.</h2>
              <p>Walk in for a tour, or call ahead and we will have someone free to show you around.</p>
            </div>

            <dl class="hours">
              @foreach (hours as row)
                <div>
                  <dt>{{ row.days }}</dt>
                  <dd>{{ row.time }}</dd>
                </div>
              @endforeach
            </dl>

            <div class="contact-lines">
              <div>{{ club.street }}, {{ club.city }}</div>
              <div><a href="{{ club.phoneHref }}">{{ club.phone }}</a></div>
              <div><a href="mailto:{{ club.email }}">{{ club.email }}</a></div>
            </div>

            <h3 class="sr-only">What comes with every membership</h3>
            <ul class="included">
              @foreach (included as item)
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
                  <span>{{ item }}</span>
                </li>
              @endforeach
            </ul>

            <div class="hero-cta">
              <a data-stx-link class="btn btn--primary" href="/visit-us">Plan your visit</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Closing call to action ────────────────────────────────── -->
      <section class="section--tight shell">
        <div class="closer rise">
          <div>
            <h2>Train stronger, move better, look your best.</h2>
          </div>
          <div>
            <p>Month to month, with a 60-day minimum. No year-long contract to sign.</p>
            <div class="hero-cta">
              <a data-stx-link class="btn btn--primary" href="/membership">Join us</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    @include('site/footer', { club, hours, footerColumns, legalLinks })
  </body>
</html>
