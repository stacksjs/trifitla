{{--
  Sticky primary navigation. `navLinks` and `current` come from the page;
  `current` is the path of the page being rendered, so the active link can
  mark itself rather than every page hard-coding its own nav.

  `data-stx-active-class` is what keeps that mark honest after the first paint.
  A client-side navigation swaps only `<main>`, so anything the server stamped
  out here survives untouched — without it the link the visitor happened to
  arrive through stays underlined however far they browse. Naming the class
  hands it to the router, which moves it (and `aria-current`) on every swap.
  The server-rendered mark stays: it is what the first paint and a JavaScript-
  less visit rely on.
--}}
<header class="nav">
  <div class="shell nav-inner">
    <a data-stx-link class="brand" href="/" aria-label="TRIFIT LA, home">
      <StxImage src="/images/trifit/TRIFIT_LOGOS_white_horizontal.png" alt="TRIFIT LA" width="132" height="25" lazy="false" />
    </a>

    <nav class="nav-links" aria-label="Primary">
      @foreach (navLinks as link)
        @if (current === link.url)
          <a data-stx-link data-stx-active-class="is-current" href="{{ link.url }}" class="is-current" aria-current="page">{{ link.label }}</a>
        @else
          <a data-stx-link data-stx-active-class="is-current" href="{{ link.url }}">{{ link.label }}</a>
        @endif
      @endforeach
    </nav>

    <div class="nav-actions">
      <button type="button" class="theme-switch" aria-pressed="false" aria-label="Switch to dark theme" onclick="trifitThemeToggle()">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4" />
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2Z" />
        </svg>
      </button>
      <a data-stx-link class="btn btn--primary btn--sm" href="/membership">Join us</a>

      <details class="nav-menu">
        <summary role="button" aria-label="Open the menu">
          <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </summary>
        <nav class="nav-menu-panel" aria-label="Primary, compact">
          {{-- Marked the same way as the bar above: `.nav-menu-panel a.is-current`
               has always been styled, and nothing ever wore it here. --}}
          @foreach (navLinks as link)
            @if (current === link.url)
              <a data-stx-link data-stx-active-class="is-current" href="{{ link.url }}" class="is-current" aria-current="page" onclick="this.closest('details').open = false">{{ link.label }}</a>
            @else
              <a data-stx-link data-stx-active-class="is-current" href="{{ link.url }}" onclick="this.closest('details').open = false">{{ link.label }}</a>
            @endif
          @endforeach
          @if (current === '/contact')
            <a data-stx-link data-stx-active-class="is-current" href="/contact" class="is-current" aria-current="page" onclick="this.closest('details').open = false">Contact</a>
          @else
            <a data-stx-link data-stx-active-class="is-current" href="/contact" onclick="this.closest('details').open = false">Contact</a>
          @endif
        </nav>
      </details>
    </div>
  </div>
</header>
